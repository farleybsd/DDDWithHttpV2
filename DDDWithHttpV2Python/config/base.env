# Equivale ao appsettings.json: vale para todos os ambientes.
# O arquivo do ambiente (config/<ambiente>.env) sobrescreve estes valores, e variáveis de
# ambiente do sistema sobrescrevem os dois.
# O "__" (dois sublinhados) separa os níveis: HTTP_RESILIENCE__RETRY__MAX_RETRY_ATTEMPTS
# vira settings.http_resilience.retry.max_retry_attempts.

NIVEL_LOG=INFO

SERVICES_SETTINGS__APOLICES_URI=

HTTP_RESILIENCE__TIMEOUT_SEGUNDOS=2
HTTP_RESILIENCE__CONCURRENCY_LIMITER__PERMIT_LIMIT=50
HTTP_RESILIENCE__CONCURRENCY_LIMITER__QUEUE_LIMIT=10
HTTP_RESILIENCE__RETRY__MAX_RETRY_ATTEMPTS=1
HTTP_RESILIENCE__RETRY__BASE_DELAY_SEGUNDOS=0.5
HTTP_RESILIENCE__CIRCUIT_BREAKER__FAILURE_RATIO=0.5
HTTP_RESILIENCE__CIRCUIT_BREAKER__SAMPLING_DURATION_SEGUNDOS=10
HTTP_RESILIENCE__CIRCUIT_BREAKER__MINIMUM_THROUGHPUT=4
HTTP_RESILIENCE__CIRCUIT_BREAKER__BREAK_DURATION_SEGUNDOS=15
